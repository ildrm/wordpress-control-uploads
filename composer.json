{
  "name": "content-firewall/wordpress-content-firewall",
  "description": "Private-by-default WordPress upload governance",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": { "php": ">=8.2", "ext-fileinfo": "*", "ext-json": "*", "ext-sodium": "*" },
  "require-dev": { "phpunit/phpunit": "^11.5", "phpstan/phpstan": "^2.1", "squizlabs/php_codesniffer": "^3.13", "wp-coding-standards/wpcs": "^3.2", "php-stubs/wordpress-stubs": "^6.8" },
  "autoload": { "psr-4": { "ContentFirewall\\": "src/" } },
  "autoload-dev": { "psr-4": { "ContentFirewall\\Tests\\": "tests/" } },
  "config": { "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true }, "sort-packages": true },
  "scripts": { "test": "phpunit", "analyse": "phpstan analyse --memory-limit=2G", "lint": "php tools/lint.php", "package": "python3 tools/package.py" }
}
